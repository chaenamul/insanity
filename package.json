{
  "name": "insanity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --prod",
    "db:migrate": "tsx server/migrate.ts",
    "story:import": "tsx tools/story-import.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content": "tsx tools/content-cli.ts",
    "content:check": "tsx tools/content-cli.ts --check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13",
    "immer": "10.1.1",
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "4.23.14"
  },
  "devDependencies": {
    "@types/node": "22.15.18",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.8.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
