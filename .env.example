# 이 파일을 .env로 복사해서 쓰세요 (.env는 git에 올라가지 않습니다)

# PostgreSQL 접속 주소. docker compose up -d 로 띄운 DB라면 그대로 쓰면 됩니다
DATABASE_URL=postgres://insanity:insanity@localhost:5432/insanity

# API 서버 포트 (개발 중엔 Vite가 /api를 여기로 넘깁니다)
PORT=3000

# npm start(배포 모드)는 기본적으로 HTTPS 전용 쿠키를 씁니다.
# HTTPS 없이 http://로 배포 모드를 시험할 때만 false로 두세요
# COOKIE_SECURE=false

# 서버 API 테스트용 DB (npm test). 이 DB의 데이터는 테스트 때마다 지워집니다
# TEST_DATABASE_URL=postgres://insanity:insanity@localhost:5432/insanity_test
